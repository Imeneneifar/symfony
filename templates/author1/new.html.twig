{% extends 'dashboard/index.html.twig' %}

{% block title %}Add author{% endblock %}

{% block body %}
    <h1 style="text-align:center;margin-bottom:16px;">Add author</h1>

    

    <div style="max-width:600px;margin:0 auto;">
        {{ form_start(form) }}
            {{ form_row(form.name) }}
            {{ form_row(form.email) }}

               <p style="text-align:center; margin-top:20px;">
       <a href="{{ path('app_author_list') }}" 
       style="background-color:#6c757d; color:white; padding:8px 16px; border-radius:6px; text-decoration:none;">
         Back to list
    </a>
</p>


            <button type="submit">SAVE</button>

        {{ form_end(form) }}
    </div>

    
{% endblock %}
