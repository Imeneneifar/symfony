{% extends 'dashboard/index.html.twig' %}

{% block title %}Liste des Auteurs{% endblock %}

{% block body %}
<h1 style="text-align:center;">Liste des Auteurs</h1>

<style>
    .btn {
        display: inline-block;
        padding: 4px 10px;
        margin: 2px;
        border: 1px solid #333;
        border-radius: 4px;
        background-color: #f9f9f9;
        color: #000;
        font-size: 13px;
        text-decoration: none;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn:hover {
        background-color: #e6e6e6;
    }

    table {
        border-collapse: collapse;
        width: 90%;
        margin: 20px auto;
    }

    th, td {
        text-align: center;
        padding: 8px;
        border: 1px solid #ddd;
    }

    th {
        background-color: #f2f2f2;
    }

    form.inline {
        display: inline;
    }
</style>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Email</th>
            <th>Age</th>
            <th>Nb Books</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    {# ici on corrige la boucle — c’est "authors" pas "author" #}
    {% for author in author %}
        <tr>
            <td>{{ author.id }}</td>
            <td>{{ author.username }}</td>
            <td>{{ author.email }}</td>
            <td>{{ author.age }}</td>
            <td>{{ author.nbBooks ?? author.books|length }}</td>
            <td>
                <a href="{{ path('app_author_edit', {'id': author.id}) }}" class="btn">Edit</a>

                <form method="post" action="{{ path('app_author_delete', {'id': author.id}) }}" class="inline" onsubmit="return confirm('Voulez-vous vraiment supprimer cet auteur ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ author.id) }}">
                    <button type="submit" class="btn">Delete</button>
                </form>
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="6">Aucun auteur trouvé.</td>
        </tr>
    {% endfor %}
    </tbody>
</table>

<p style="text-align:center; margin-top:20px;">
    <a href="{{ path('app_author_new') }}" class="btn">Ajouter un auteur</a>
</p>
{% endblock %}
