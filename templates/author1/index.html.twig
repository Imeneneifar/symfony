{% extends 'dashboard/index.html.twig' %}

{% block title %}List authors{% endblock %}

{% block body %}
  <h1 style="text-align:center;margin:16px 0;">List authors</h1>

  <p style="text-align:center;margin-bottom:12px;">
    <a href="{{ path('app_author_new') }}"> add author</a>
  </p>

  <table border="1" cellspacing="0" cellpadding="8" align="center">
    <thead>
      <tr>
        <th>ID</th>
        <th>Username</th>
        <th>Email</th>
        <th>NBR</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for author in authors %}
        <tr>
          <td>{{ author.id }}</td>
          <td>{{ author.name }}</td>
          <td>{{ author.email }}</td>
          <td>{{ author.nbr }}</td>

          <td>
  <a href="{{ path('app_author_edit', {id: author.id}) }}"> Edit</a>

  <form method="post"
        action="{{ path('app_author_delete', {id: author.id}) }}"
        style="display:inline"
        onsubmit="return confirm('Supprimer cet auteur ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ author.id) }}">
    <button type="submit"> Delete</button>
  </form>
</td>
        </tr>
      {% else %}
        <tr>
          <td colspan="5">Aucun auteur trouvé.</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endblock %}
