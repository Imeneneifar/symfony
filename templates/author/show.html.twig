{% extends 'dashboard/index.html.twig' %}

{% block title %}Exemples Twig{% endblock %}

{% block body %}
  <h1>Exemples Twig</h1>

  <p><strong>Nom en majuscules :</strong> {{ name|upper }}</p>

  <p><em>Trim & lower:</em> {{ '&hello3A24'|lower|trim('&') }}</p>

  <p>
    <a href="{{ path('afficher') }}">Lien 1 (path)</a> |
    <a href="{{ url('afficher') }}">Lien 2 (url)</a>
  </p>

  <img src="{{ asset('assets/images/symfony.png') }}" alt="symfony">
{% endblock %}
