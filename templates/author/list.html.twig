<h1>Liste des Auteurs</h1>

{% if authors is defined and authors is not empty %}
    <table border="1" cellpadding="8" cellspacing="0">
        <thead>
            <tr>
                <th>Photo</th>
                <th>Nom</th>
                <th>Email</th>
                <th>Nombre de livres</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            {% for author in authors %}
                <tr>
                    <td>
                        <img src="{{ asset(author.picture) }}" alt="{{ author.username }}" width="120">
                    </td>
                    <td>{{ author.username|upper }}</td>
                    <td>{{ author.email }}</td>
                    <td>{{ author.nb_books }}</td>
                    <td>
                    <a href="{{ path('author_details', { id: author.id }) }}">details</a>
                    </td>

                </tr>
            {% endfor %}
        </tbody>
    </table>

    <p><strong>Nombre d'auteurs :</strong> {{ authors|length }}</p>

    <p>
        <strong>Nombre total de livres :</strong>
        {{ authors|map(a => a.nb_books)|reduce((carry, v) => carry + v) }}
    </p>
{% else %}
    <p>Aucun auteur trouvé.</p>
{% endif %}

