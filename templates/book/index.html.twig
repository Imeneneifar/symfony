{% extends 'dashboard/index.html.twig' %}

{% block title %}List of books{% endblock %}
{% block body %}
<h1 style="text-align:center">BOOKS</h1>
<p style="text-align:center"><a href="{{ path('app_book_new') }}"> New book</a></p>
<table border="1" cellpadding="6" cellspacing="0" align="center">
 <thead><tr><th>REF</th><th>Title</th><th>CATEGORY</th><th>Date</th><th>Published</th><th>Author</th><th>Actions</th></tr></thead>
 <tbody>
 {% for b in books %}
   <tr>
     <td>{{ b.id }}</td>
     <td>{{ b.title }}</td>
     <td> {{ b.category  }}</td>
     <td>{{ b.publicationDate ? b.publicationDate|date('Y-m-d') : '' }}</td>
     <td>{{ b.enabled ? 'Oui' : 'Non' }}</td>
     <td>
       <a href="{{ path('app_book_edit', {id:b.id}) }}"> Edit</a>
       <form method="post" action="{{ path('app_book_delete',{id:b.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer ?');">
         <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ b.id) }}">
         <button type="submit"> Delete</button>
       </form>
      <a href="{{ path('app_book_show', { id: b.id }) }}">show</a>

     </td>
   </tr>
 {% else %}
   <tr><td colspan="6">No Books found</td></tr>
 {% endfor %}
 </tbody>
 

</table>
{% endblock %}
