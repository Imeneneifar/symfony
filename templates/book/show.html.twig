{% extends 'dashboard/index.html.twig' %}

{% block title %}Book details{% endblock %}

{% block body %}
  <h1>Book</h1>

  <p><strong>Title of Book:</strong> {{ book.title }}</p>
  <p><strong>Publication date:</strong> {{ book.publicationDate ? book.publicationDate|date('Y-m-d H:i') : '—' }}</p>
  <p><strong>Published:</strong> {{ book.enabled ? 'Oui' : 'Non' }}</p>
  <p><strong>Category:</strong> {{ book.category }}</p>
  <p><strong>Author :</strong> {{ book.author1.name }}</p>

  <p style="margin-top:16px;">
    <a href="{{ path('app_book_list') }}"> back to list</a> 
  </p>
{% endblock %}
